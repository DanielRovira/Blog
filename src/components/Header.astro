---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import { configNichos } from '../config/nichos.js';

export interface Props {
  nicho?: keyof typeof configNichos;
}

const { nicho = 'default' } = Astro.props;
const dadosNicho = configNichos[nicho] || configNichos.default;
const isDefault = nicho === 'default';

// Lógica de Cores e Identidade Visual
const headerBg = isDefault ? 'white' : dadosNicho.color;
const activeColor = isDefault ? 'var(--accent)' : 'white';
const brandName = isDefault ? SITE_TITLE : dadosNicho.title;
const brandUrl = isDefault ? '/' : (dadosNicho.links[0]?.url || `/${nicho}`);
const linksPrincipais = dadosNicho.links.filter((link) => link.principal);
const linksDropdown = dadosNicho.links.filter((link) => !link.principal);
---

<header style={`--header-bg: ${headerBg}; --header-text: ${isDefault ? 'var(--black)' : 'white'}; --header-active: ${activeColor};`}>
	<nav>
		<h2><a href={brandUrl}>{brandName}</a></h2>
		
		<div class="internal-links">
			{isDefault ? (
				dadosNicho.links.map((link) => (
					<HeaderLink href={link.url}>{link.label}</HeaderLink>
				))
			) : (
				<>
					<div class="category-links">
						{linksPrincipais.map((link) => (
							<HeaderLink href={link.url} class="category-header-link" data-category-link>{link.label}</HeaderLink>
						))}
					</div>
					{linksDropdown.length > 0 && <div class="dropdown category-dropdown">
						<span class="dropbtn category-dropdown-button" data-category-toggle>Mais categorias</span>
						<div class="dropdown-content category-dropdown-content">
							{linksDropdown.map((link) => (
								<a href={link.url} data-category-link>{link.label}</a>
							))}
						</div>
					</div>}
				</>
			)}
			{isDefault && (
			    <div class="dropdown">
			    	<HeaderLink href="/blogs" class="dropbtn">Blogs ▾</HeaderLink>
			    	<div class="dropdown-content">
			    		{Object.entries(configNichos)
			    			.filter(([key]) => key !== 'default')
			    			.map(([key, n]) => (
			    				<a href={`/${key}`}>{n.title}</a>
			    			))}
			    	</div>
			    </div>
            )}
		</div>
	</nav>
</header>

<script>
	const currentPath = window.location.pathname.replace(/\/$/, '');
	const currentCategory = new URLSearchParams(window.location.search).get('category');

	document.querySelectorAll('[data-category-link]').forEach((link) => {
		const anchor = link as HTMLAnchorElement;
		const linkUrl = new URL(anchor.href, window.location.origin);
		const linkPath = linkUrl.pathname.replace(/\/$/, '');
		const linkCategory = linkUrl.searchParams.get('category');
		const isActive = linkPath === currentPath && linkCategory === currentCategory;

		anchor.classList.toggle('active', isActive);

		if (isActive && link.closest('.category-dropdown-content')) {
			const toggle = document.querySelector('[data-category-toggle]');
			if (toggle) {
				toggle.textContent = `Mais: ${anchor.textContent}`;
				toggle.classList.add('active');
			}
		}
	});
</script>
<style>
	header {
		margin: 0;
		padding: 0 1rem;
		background: var(--header-bg);
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
        position: sticky;
        top: 0;
		z-index: 10;
	}
	h2 {
		margin: 0;
		font-size: 1em;
		line-height: 1.2;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
		color: var(--header-text);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--header-text);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	.category-dropdown-button {
		display: inline-block;
		padding: 1em 0.5em;
		color: var(--header-text);
		border-bottom: 4px solid transparent;
		white-space: nowrap;
		cursor: default;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--header-active);
	}
	.category-dropdown-button.active {
		font-weight: bolder;
		border-bottom-color: var(--header-active);
	}
	
	.social-links,
	.social-links a {
		display: flex;
	}
	.social-links a {
		color: var(--header-text);
	}
	
	/* Dropdown styles */
	.internal-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: flex-end;
		margin-left: auto;
	}

	.category-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
	}

	.internal-links .category-dropdown {
		display: inline-block;
	}

	.dropdown {
		position: relative;
		display: inline-block;
	}
	
	/* Override HeaderLink for dropdown container visually if needed, but it works natively now */
	.dropdown:hover .dropbtn {
		background-color: #f1f1f1;
	}

	.category-dropdown:hover .dropbtn {
		background-color: #ffffff50;
	}

	.category-dropdown-button::after {
		content: "\25BE";
		margin-left: 0.35em;
	}
	
	.dropdown-content {
		display: none;
		position: absolute;
		top: 100%;
		background-color: white; /* Always white so links are legible */
		min-width: min(200px, calc(100vw - 2rem));
        width: max-content;
		box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.1);
		z-index: 1;
		border-radius: 4px;
		overflow: hidden;
        right: 0; /* Align to the right of the dropdown button */
	}
	.dropdown-content a {
		color: black;
		padding: 12px 16px;
		text-decoration: none;
		display: block;
		border-bottom: none;
	}
	.dropdown-content a:hover {
		background-color: #f1f1f1;
		color: var(--accent);
	}
	.dropdown:hover .dropdown-content {
		display: block;
	}

	@media (max-width: 720px) {
		nav {
			align-items: flex-start;
			gap: 0.5rem;
			padding: 0.5rem 0;
		}
		nav h2 {
			padding: 0.5rem 0;
		}
		.internal-links {
			justify-content: flex-end;
			gap: 0.25rem;
		}
		nav a {
			padding: 0.5rem 0.35rem;
		}
		.category-dropdown-button {
			padding: 0.5rem 0.35rem;
		}
		.social-links {
			display: none;
		}
	}

	@media (max-width: 520px) {
		nav {
			flex-direction: column;
		}
		.internal-links {
			width: 100%;
			justify-content: flex-start;
			margin-left: 0;
		}
	}
</style>
