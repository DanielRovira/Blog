---
import { configNichos } from '../../config/nichos.js';

export interface Props {
  nicho: keyof typeof configNichos;
  href: string;
  label?: string;
}

const { nicho, href, label } = Astro.props;
const dadosNicho = configNichos[nicho] || configNichos.default;
---

<a 
  href={href} 
  class="btn-nicho" 
  style={`--button-color: ${dadosNicho.color};`}
>
  {label ? label : <slot />}
</a>

<style>
  .btn-nicho {
    display: inline-block;
    padding: 0.5rem 1rem;
    color: white;
    text-decoration: none;
    border-radius: 4px;
    font-weight: bold;
    background-color: var(--button-color);
    border: 2px solid var(--button-color);
    transition: filter 0.2s;
  }
  
  .btn-nicho:hover {
    filter: brightness(0.9);
    color: white;
  }
</style>

