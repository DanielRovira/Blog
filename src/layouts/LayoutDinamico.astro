---
import { configNichos } from '../config/nichos.js';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import fs from 'node:fs';
import path from 'node:path';

export interface Props {
  title: string;
  nicho?: keyof typeof configNichos;
  description?: string;
  icon?: string; 
}

const { nicho = 'default', title, description = "", icon } = Astro.props;
const dadosNicho = configNichos[nicho] || configNichos.default;

const iconeRelativoPublic = `/${nicho}/icone-nicho.svg`;
const caminhoFisicoIcone = path.join(process.cwd(), 'public', iconeRelativoPublic);
const temIconePersonalizado = fs.existsSync(caminhoFisicoIcone);
const iconeFinal = icon || (temIconePersonalizado ? iconeRelativoPublic : undefined);
---

<html lang="pt-BR">
  <head>
    <BaseHead title={`${title} | ${dadosNicho.title}`} description={description} icon={iconeFinal} />
    
    <style>
      body {
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      main.layout-main {
        flex: 1;
        width: 100%;
        max-width: 960px;
        margin: 0 auto;
        padding: clamp(1.5rem, 4vw, 2.5rem) clamp(0.75rem, 3vw, 1.5rem);
      }
      
      .prose {
        width: min(720px, 100%);
        margin: auto;
        padding: 1rem;
        color: rgb(var(--gray-dark));
      }

      .prose :global(img) {
        display: block;
        width: 100%;
        height: min(405px, 56.25vw);
        margin: 2rem 0;
        border-radius: 12px;
        object-fit: cover;
        box-shadow: var(--box-shadow);
      }

      @media (max-width: 480px) {
        .prose {
          padding: 0.5rem 0;
        }
      }
    </style>
  </head>
  <body>
    
    <Header nicho={nicho} />
    
    <main class="layout-main">
      <article>
        <div class="prose">
          <slot />
        </div>
      </article>
    </main>

    <Footer />
  </body>
</html>