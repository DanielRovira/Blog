---
import { configNichos } from '../config/nichos.js';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  nicho?: keyof typeof configNichos;
  description?: string;
  heroImage?: string;
}

const { nicho = 'default', title, description = "", heroImage } = Astro.props;
const dadosNicho = configNichos[nicho] || configNichos.default;
---

<html lang="pt-BR">
  <head>
    <BaseHead title={`${title} | ${dadosNicho.title}`} description={description} />
    <style>
      body {
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      main.layout-main {
        flex: 1;
        width: 100%;
        max-width: 960px;
        margin: 0 auto;
        padding: clamp(1.5rem, 4vw, 2.5rem) clamp(0.75rem, 3vw, 1.5rem);
      }
      
      .hero-image {
        width: 100%;
      }
      .hero-image img {
        display: block;
        margin: 0 auto;
        border-radius: 12px;
        box-shadow: var(--box-shadow);
      }
      
      .prose {
        width: min(720px, 100%);
        margin: auto;
        padding: 1rem;
        color: rgb(var(--gray-dark));
      }

      @media (max-width: 480px) {
        .prose {
          padding: 0.5rem 0;
        }
      }

    </style>
  </head>
  <body>
    
    <Header nicho={nicho} />
    
    <main class="layout-main">
      <article>
        <div class="hero-image">
          {heroImage && <img width={1020} height={510} src={heroImage} alt="" />}
        </div>
        
        <div class="prose">
          <slot />
        </div>
      </article>
    </main>

    <Footer />
  </body>
</html>