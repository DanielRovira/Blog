---
import { render, getCollection, type CollectionKey } from 'astro:content';
import LayoutDinamico from '../../../layouts/LayoutDinamico.astro';
import OfertaInfoproduto from '../../../components/ui/OfertaInfoproduto.astro';
import { configNichos } from '../../../config/nichos';
import fs from 'node:fs';
import path from 'node:path';

type NichoKey = keyof Omit<typeof configNichos, 'default'>;

export async function getStaticPaths() {
  const nichos = Object.keys(configNichos).filter(k => k !== 'default') as NichoKey[];
  let paths: Array<{ params: { niche: string; slug: string }; props: { artigo: any; niche: NichoKey } }> = [];

  for (const niche of nichos) {
    const artigos = await getCollection(niche as CollectionKey);
    for (const artigo of artigos) {
      paths.push({
        params: { niche, slug: artigo.id },
        props: { artigo, niche },
      });
    }
  }

  return paths;
}

interface Props {
  artigo: any;
  niche: NichoKey;
}

const { artigo, niche } = Astro.props as Props;
const { Content } = await render(artigo); // Nota: Lembre-se de importar o render de 'astro:content'

// Validação dinâmica da imagem de capa por convenção
const caminhoRelativoPublic = `/${niche}/${artigo.id}/capa.jpeg`;
const caminhoFisico = path.join(process.cwd(), 'public', caminhoRelativoPublic);
const caminhoImagem = fs.existsSync(caminhoFisico) ? caminhoRelativoPublic : null;
---

<LayoutDinamico nicho={niche} title={artigo.data.title} description={artigo.data.description}>
  <div class="article-header">
    <h1>{artigo.data.title}</h1>
    <p>{artigo.data.description}</p>
  </div>
  
  {caminhoImagem && (
    <div class="article-cover">
      <img 
        src={caminhoImagem} 
        alt={`Capa: ${artigo.data.title}`} 
        class="article-cover-image"
      />
    </div>
  )}

  <hr class="article-divider" />

  <Content /> 

  <OfertaInfoproduto nicho={niche} />
  
  <div class="article-footer">
    <a href={`/${niche}`}>&larr; Voltar</a>
  </div>
</LayoutDinamico>

<style>
  .article-header {
    margin-bottom: 2rem;
    text-align: center;
  }

  .article-header h1 {
    margin-bottom: 0.5rem;
  }

  .article-header p {
    color: rgb(var(--gray));
    font-size: 1.1rem;
  }

  .article-cover {
    margin-bottom: 2rem;
    overflow: hidden;
    border-radius: 12px;
    box-shadow: var(--box-shadow);
  }

  .article-cover-image {
    display: block;
    width: 100%;
    height: auto;
    max-height: 450px;
    object-fit: cover;
  }

  .article-divider {
    margin: 2rem 0;
    border: 0;
    border-top: 1px solid rgb(var(--gray-light));
  }

  .article-footer {
    margin-top: 4rem;
  }

  .article-footer a {
    font-weight: bold;
    text-decoration: none;
  }

  @media (max-width: 480px) {
    .article-header p {
      font-size: 1rem;
    }

    .article-footer {
      margin-top: 3rem;
    }
  }
</style>