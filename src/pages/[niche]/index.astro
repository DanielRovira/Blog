---
import LayoutDinamico from '../../layouts/LayoutDinamico.astro';
import GridPosts from '../../components/ui/GridPosts.astro';
import { getCollection, type CollectionKey } from 'astro:content';
import { configNichos } from '../../config/nichos';
import fs from 'node:fs';
import path from 'node:path';

type NichoKey = keyof Omit<typeof configNichos, 'default'>;

export function getStaticPaths() {
  const nichos = Object.keys(configNichos).filter(k => k !== 'default') as NichoKey[];
  
  return nichos.map((niche) => ({
    params: { niche },
  }));
}

const { niche } = Astro.params as { niche: NichoKey };
const configNicho = configNichos[niche] || configNichos.default;

const artigos = await getCollection(niche as CollectionKey);

const gridItems = artigos.map((article) => {
  const caminhoRelativoPublic = `/${niche}/${article.id}/capa.jpeg`;
  const caminhoFisico = path.join(process.cwd(), 'public', caminhoRelativoPublic);
  const temImagem = fs.existsSync(caminhoFisico);

  return {
    url: `/${niche}/contents/${article.id}`,
    title: article.data.title,
    description: article.data.description,
    color: configNicho.color,
    tagText: article.data.title,
    image: temImagem ? caminhoRelativoPublic : undefined
  };
});
---

<LayoutDinamico nicho={niche} title={configNicho.title}>
  <div class="page-intro">
    <h1>{configNicho.title}</h1>
    <p>{configNicho.description}</p>
  </div>
  
  <GridPosts items={gridItems} />
</LayoutDinamico>

<style>
  .page-intro {
    margin-bottom: 2rem;
    text-align: center;
  }

  .page-intro p {
    margin-right: auto;
    margin-left: auto;
  }
</style>