---
import LayoutDinamico from '../../layouts/LayoutDinamico.astro';
import GridPosts from '../../components/ui/GridPosts.astro';
import SearchBar from '../../components/Search/SearchBar.astro';
import { getCollection, type CollectionKey } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { configNichos } from '../../config/nichos';

type NichoKey = keyof Omit<typeof configNichos, 'default'>;

export function getStaticPaths() {
  const nichos = Object.keys(configNichos).filter(k => k !== 'default') as NichoKey[];
  
  return nichos.map((niche) => ({
    params: { niche },
  }));
}

const { niche } = Astro.params as { niche: NichoKey };
const configNicho = configNichos[niche] || configNichos.default;
const category = Astro.url.searchParams.get('category');

const artigos = await getCollection(niche as CollectionKey);
const capas = import.meta.glob('../../content/*/*/capa.webp', {
  eager: true,
  import: 'default',
}) as Record<string, ImageMetadata>;

const gridItems = artigos.map((article) => {
  const capa = capas[`../../content/${niche}/${article.id}/capa.webp`];

  return {
    url: `/${niche}/contents/${article.id}`,
    title: article.data.title,
    description: article.data.description,
    category: article.data.category,
    color: configNicho.color,
    tagText: article.data.title,
    image: capa
  };
});
---

<LayoutDinamico
  nicho={niche}
  title={configNicho.title}
  description={configNicho.description}
>
  <div class="page-intro">
    <h1>{configNicho.title}</h1>
    <p>{configNicho.description}</p>
  </div>

  <SearchBar collectionName={niche} />

  <nav class="category-tabs" aria-label="Categorias">
    {configNicho.links.map((link) => (
      <a href={link.url} class:list={{ active: link.url === (category ? `/${niche}?category=${category}` : `/${niche}`) }}>{link.label}</a>
    ))}
  </nav>
  
  <GridPosts items={gridItems} />
</LayoutDinamico>

<script>
  const category = new URLSearchParams(window.location.search).get('category');
  const posts = document.querySelectorAll('[data-category]');
  const currentPath = window.location.pathname.replace(/\/$/, '');

  posts.forEach((post) => {
    const matches = !category || post.getAttribute('data-category') === category;
    post.toggleAttribute('hidden', !matches);
  });

  document.querySelectorAll('.category-tabs a').forEach((link) => {
    const anchor = link as HTMLAnchorElement;
    const linkUrl = new URL(anchor.href, window.location.origin);
    const linkPath = linkUrl.pathname.replace(/\/$/, '');
    const linkCategory = linkUrl.searchParams.get('category');
    const isActive = linkPath === currentPath && linkCategory === category;

    anchor.classList.toggle('active', isActive);
  });
</script>

<style>
  .page-intro {
    margin-bottom: 2rem;
    text-align: center;
  }

  .page-intro p {
    margin-right: auto;
    margin-left: auto;
  }

  .category-tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .category-tabs a {
    padding: 0.5rem 0.75rem;
    border: 1px solid rgb(var(--gray-light));
    border-radius: 6px;
    color: rgb(var(--black));
    text-decoration: none;
  }

  .category-tabs a:hover,
  .category-tabs a.active {
    color: white;
    background: var(--accent);
    border-color: var(--accent);
  }
</style>