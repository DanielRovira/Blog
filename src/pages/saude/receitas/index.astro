---
import LayoutDinamico from '../../../layouts/LayoutDinamico.astro';
import GridPosts from '../../../components/ui/GridPosts.astro';
import { getCollection } from 'astro:content';

const todasAsReceitas = await getCollection('saude');
const gridItems = todasAsReceitas.map((receita) => ({
  url: `/saude/receitas/${receita.id}`,
  title: receita.data.titulo,
  description: receita.data.descricao,
  color: '#10b981',
  tagText: receita.data.titulo.substring(0, 2)
}));
---

<LayoutDinamico nicho="saude" title="Receitas">
  <div style="text-align: center; margin-bottom: 2rem;">
    <h1>Lista de Receitas</h1>
    <p>Explore todas as nossas receitas para sua dieta.</p>
  </div>
  
  <GridPosts items={gridItems} />
</LayoutDinamico>