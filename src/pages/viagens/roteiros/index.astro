---
import LayoutDinamico from '../../../layouts/LayoutDinamico.astro';
import GridPosts from '../../../components/ui/GridPosts.astro';
import { getCollection } from 'astro:content';

const roteiros = await getCollection('viagens');
const gridItems = roteiros.map((roteiro) => ({
  url: `/viagens/roteiros/${roteiro.id}`,
  title: roteiro.data.titulo,
  description: roteiro.data.descricao,
  color: '#3b82f6',
  tagText: roteiro.data.titulo.substring(0, 2)
}));
---

<LayoutDinamico nicho="viagens" title="Roteiros">
  <div style="text-align: center; margin-bottom: 2rem;">
    <h1>Todos os Roteiros</h1>
    <p>Inspire-se para sua próxima viagem com nossos guias completos.</p>
  </div>
  
  <GridPosts items={gridItems} />
</LayoutDinamico>
